<Project Sdk="Microsoft.NET.Sdk">

  <!-- OpenNest for Grasshopper 2 on RHINO 9. GH2 only really ships (and works) inside Rhino 9, so this
       compiles against McNeel's official Rhino-9 "Grasshopper2" reference-assembly NuGet (9.0.x-wip), which
       transitively pins the matching RhinoCommon 9.x. That RhinoCommon 9 reference is also what makes
       `yak build` tag the OpenNest_GH2 package rh9 — so the Package Manager only offers it on Rhino 9+.
       (The old Rhino-8 GH2 SDK, Grasshopper2 2.0.x-wip, is a vestigial dead end; see publish.yml.)
       Reuses the existing nesting logic in opennest_2 via a ProjectReference. -->

  <PropertyGroup>
    <!-- net8.0-windows for the Windows Yak package; net8.0 (portable) for the macOS package — Rhino 9 loads
         the net8 flavor of GH2. The plugin uses only cross-platform APIs (Eto, Rhino.Geometry, GH2), so the
         net8.0 build is cross-built on the Windows CI runner, mirroring opennest_2 / opennest_commands. -->
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <!-- GH2 component libraries are .rhp (like the native G2*Components.rhp). They are loaded by the
         Grasshopper 2 host from GH2's Components folder, which the Rhino plug-in manager does NOT scan -
         so there is no "register as a Rhino plug-in" attempt and no popup. (.gha would route to Grasshopper
         1, which can't load a GH2 assembly.) -->
    <TargetExt>.rhp</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>opennest_gh2</AssemblyName>
    <RootNamespace>opennest_gh2</RootNamespace>
    <NoWarn>NU1701;NU1603;NETSDK1086;CA1416;CS0618</NoWarn>
    <!-- Rhino 9 install root (override on the command line for a different location / CI). The GH2 + UI
         reference assemblies are taken from the installed Rhino, NOT a NuGet, so opennest_gh2.deps.json
         stays minimal (only our own assemblies) like the native G2 components — the running host then
         supplies Eto / Grasshopper2 / RhinoCommon at load time. -->
    <RhinoR9 Condition="'$(RhinoR9)'==''">$(ProgramFiles)\Rhino 9 WIP</RhinoR9>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the Rhino-9 GH2 NuGet (it unifies the transitive Eto 2.11 / RhinoCommon 9 that the
         opennest_2 reference would otherwise clash with). ExcludeAssets=runtime keeps the package DLLs out
         of the output; the WriteMinimalDeps target below then strips the host assemblies from deps.json so
         the load context defers Eto / Grasshopper2 / RhinoCommon to the running Rhino host (like native G2). -->
    <PackageReference Include="Grasshopper2" Version="9.0.26160.12305-wip" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- A GH2 plug-in's deps.json must list ONLY its own assembly (the native G2*Components.rhp do exactly
       this). Any host assembly left in deps.json (Eto, Grasshopper2, GrasshopperIO, RhinoCommon, the BCL
       shims) makes the plug-in load context try to resolve it from the package folder and throw
       "application initialization failed". Overwrite the generated deps.json with the minimal form. -->
  <Target Name="WriteMinimalDeps" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_Deps>$(OutDir)opennest_gh2.deps.json</_Deps>
      <_MinDeps>{
  "runtimeTarget": { "name": ".NETCoreApp,Version=v8.0", "signature": "" },
  "compilationOptions": {},
  "targets": { ".NETCoreApp,Version=v8.0": { "opennest_gh2/1.0.0": { "runtime": { "opennest_gh2.rhp": {} } } } },
  "libraries": { "opennest_gh2/1.0.0": { "type": "project", "serviceable": false, "sha512": "" } }
}</_MinDeps>
    </PropertyGroup>
    <WriteLinesToFile File="$(_Deps)" Lines="$(_MinDeps)" Overwrite="true" Condition="Exists('$(_Deps)')" />
  </Target>

  <ItemGroup>
    <!-- Component icons. The SVGs are converted to GH2 true-vector icons at runtime (SvgVectorIcon); the PNGs
         are the per-icon raster fallback. Logical names: opennest_gh2.icons.<file>.svg / .png -->
    <EmbeddedResource Include="icons\*.svg" />
    <EmbeddedResource Include="icons\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse nest_geo/nest_sheets/NpRun/rhino_example/wrappers from the GH1 assembly (net8 may reference
         net7). Private=false: opennest_2.gha + native DLLs are bundled next to the .rhp and resolved by an
         AssemblyResolve hook in the plugin (so we don't depend on GH1 having loaded them). -->
    <ProjectReference Include="..\opennest_2\opennest_2.csproj" Private="false" />
  </ItemGroup>

</Project>
