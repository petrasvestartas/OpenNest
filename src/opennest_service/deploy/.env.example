# Copy to .env and fill in. Never commit .env.

# The public host name; its DNS A record must point at this server before `docker compose up`.
OPENNEST_DOMAIN=nest.example.com

# The one password for the page and the API (at least 8 characters; e.g. `openssl rand -hex 16`).
OPENNEST_PASSWORD=

# Concurrency. Default: 1 job at a time on ~75% of the cores. Packing quality grows with the threads a
# job gets (the solver runs that many parallel explorations), so more slots = more customers served at
# once but weaker layouts each. Keep SLOTS x THREADS_PER_JOB at or below ~75% of the cores.
OPENNEST_SLOTS=1
# OPENNEST_THREADS_PER_JOB=12

# Longest run a job may ask for, seconds (the page offers up to 60 minutes).
OPENNEST_MAX_WALL=3600

# The session_viewer page the "open in viewer" links use.
OPENNEST_VIEWER_URL=https://petrasvestartas.github.io/session/
