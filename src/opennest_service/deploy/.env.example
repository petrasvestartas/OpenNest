# Copy to .env and fill in. Never commit .env.

# The public host name; its DNS A record must point at this server before `docker compose up`.
OPENNEST_DOMAIN=nest.example.com

# Long random string for the /api/admin endpoints (e.g. `openssl rand -hex 32`).
OPENNEST_ADMIN_TOKEN=

# Concurrency. Default: 1 job at a time on ~75% of the cores. Packing quality grows with the threads a
# job gets (the solver runs that many parallel explorations), so more slots = more customers served at
# once but weaker layouts each. Keep SLOTS x THREADS_PER_JOB at or below ~75% of the cores.
OPENNEST_SLOTS=1
# OPENNEST_THREADS_PER_JOB=12

# Free credits for a self-service signup (1 credit = 1 second on one worker slot).
OPENNEST_SIGNUP_CREDITS=600
# Free 30 s previews without an account (1 at a time and 20 per hour per IP).
OPENNEST_ANON_PREVIEW=1

# Paddle Billing (leave empty to run without payments). The webhook URL to register in Paddle is
# https://$OPENNEST_DOMAIN/api/webhooks/paddle, event transaction.completed.
OPENNEST_PADDLE_SECRET=
OPENNEST_PADDLE_CLIENT_TOKEN=
# price id = credit-seconds per unit, comma separated, e.g. pri_01abc=3600,pri_01def=36000
OPENNEST_PADDLE_PRICES=

# The session_viewer page the "open in viewer" links use.
OPENNEST_VIEWER_URL=https://petrasvestartas.github.io/session/
